# INERT TEMPLATE. Review before copying into .github/workflows/.
# Replace OWNER/REPO and REVIEWED_ACTIONS_CHECKOUT_COMMIT_SHA below.
# Replace REVIEWED_PASSKEY_ACTION_COMMIT_SHA with the reviewed immutable
# commit containing the paired action hardening before enabling this template.
# Never use this workflow with untrusted PR code or unreviewed refs.
name: Authorized development passkey login

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  login:
    # Repository and default-ref allowlist; replace OWNER/REPO explicitly.
    if: >-
      github.repository == 'OWNER/REPO' &&
      github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Check out the reviewed workflow revision
        uses: actions/checkout@REVIEWED_ACTIONS_CHECKOUT_COMMIT_SHA
        with:
          ref: ${{ github.sha }}
          persist-credentials: false

      - name: Authenticate the authorized development account
        id: passkey
        uses: nathanmcnulty/action-passkey-login@REVIEWED_PASSKEY_ACTION_COMMIT_SHA
        with:
          credential-id: ${{ secrets.PASSKEY_PRIVATE_CREDENTIAL_ID }}
          user-handle: ${{ secrets.PASSKEY_PRIVATE_USER_HANDLE }}
          user-principal-name: ${{ secrets.PASSKEY_PRIVATE_USER_PRINCIPAL_NAME }}
          private-key: ${{ secrets.PASSKEY_PRIVATE_KEY }}
          confirm-application: 'false'
          export-auth-cookie: 'false'

      - name: Verify the non-secret success flag
        shell: pwsh
        env:
          AUTHENTICATED: ${{ steps.passkey.outputs.authenticated }}
        run: |
          if ($env:AUTHENTICATED -ne 'true') {
            throw 'Authentication was not confirmed.'
          }
          Write-Host 'Authentication confirmed. No session cookie was exported.'
